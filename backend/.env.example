# Copy this file to .env and fill in real values.
# Never commit .env — it's already covered by the root .gitignore.

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/meditrack

# JWT signing secret — any long random string, e.g. `openssl rand -base64 32`
JWT_SECRET=replace-with-a-long-random-string

# Master key that wraps each patient's per-patient encryption key.
# Generate with: openssl rand -base64 32
MEDITRACK_MASTER_KEY=replace-with-a-generated-256-bit-key

# Server port
PORT=4000
